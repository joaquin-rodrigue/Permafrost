  m_Name: VFXUI
  m_EditorClassIdentifier: 
  groupInfos:
  - title: Sine Wave Force
    position:
      serializedVersion: 2
      x: -646
      y: 897
      width: 844
      height: 434
    contents:
    - model: {fileID: 8926484042661615172}
